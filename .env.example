# Accountedfor configuration. Copy to .env and edit:  cp .env.example .env
# Every variable is optional except where noted.

# --- Required ---------------------------------------------------------------

# Public address of this board, used in links, SMS replies and cookies.
# Use https:// in production (cookies then get the Secure flag and HSTS is on).
BASE_URL=http://localhost:8080

# PostgreSQL connection string. docker-compose.yml sets this for you.
# DATABASE_URL=postgres://accountedfor:secret@localhost:5432/accountedfor?sslmode=disable

# Password for the bundled PostgreSQL container (docker-compose.yml only).
POSTGRES_PASSWORD=change-me-please

# --- What people see ---------------------------------------------------------

SITE_NAME=Accountedfor
# Shown under the name on every page, e.g. "Riverside Flood · November 2026".
EVENT_NAME=
# Who runs this board and how to reach them (footer and privacy page).
OPERATOR_NAME=
OPERATOR_CONTACT=
# Optional banner on every page, e.g. "Boil water notice in effect for zip 92501."
NOTICE=
# Default language when the browser does not ask for one: en or es.
DEFAULT_LANGUAGE=en
# Time zone for dates on pages (IANA name).
TIMEZONE=UTC

# --- Responders ----------------------------------------------------------------

# Creates an administrator on first start if there are no accounts yet.
# Remove it after signing in. You can also run:
#   docker compose exec app accountedfor user add NAME --admin
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=
# How long a responder stays signed in.
SESSION_HOURS=12

# --- SMS -------------------------------------------------------------------------

# Number shown on the home page ("Text SAFE and your name to ...").
SMS_NUMBER=
# Visibility of posts made by text message: public, limited or private.
SMS_DEFAULT_VISIBILITY=limited
# Twilio: set the number's incoming-message webhook to POST {BASE_URL}/sms/twilio.
# Requests are verified with this token.
TWILIO_AUTH_TOKEN=
# Any other gateway: POST {BASE_URL}/sms/inbound with
# "Authorization: Bearer <secret>" and form or JSON fields "from" and "body".
SMS_WEBHOOK_SECRET=

# --- Data --------------------------------------------------------------------------

# Records are deleted automatically this many days after they are made (0 = never).
RETENTION_DAYS=180
# Serve public information as PFIF 1.4 at {BASE_URL}/pfif.xml.
PUBLIC_FEED=true
# Domain used in PFIF record IDs (defaults to the BASE_URL host). Never change
# it after records exist: other systems use the IDs to recognize updates.
PFIF_DOMAIN=

# --- Operations --------------------------------------------------------------------

# Address to listen on (or set PORT, as most hosting platforms do).
LISTEN_ADDR=:8080
# Set to true behind a reverse proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=false
# Posts per hour per IP address. Shelters and phone networks share addresses,
# so keep this generous.
RATE_LIMIT_POSTS_PER_HOUR=120
# Text messages per hour per phone number.
RATE_LIMIT_SMS_PER_HOUR=30
# Logging: text or json; debug, info, warn or error.
LOG_FORMAT=text
LOG_LEVEL=info
